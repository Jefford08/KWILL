# Copy this file to `.env` for local development (`.env` is git-ignored).
# On Vercel, set the same variables in Project -> Settings -> Environment Variables.

# Supabase connection string: Supabase dashboard -> your project -> Connect.
#   On Vercel: use "Transaction pooler" (port 6543).
#   Locally:   "Session pooler" (port 5432) or the transaction pooler both work.
# Replace [YOUR-PASSWORD] with the database password, URL-encoding any special
# characters (e.g. @ -> %40, # -> %23, / -> %2F). Don't add `?sslmode=...`.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Long random string used to sign login session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Set to `production` on Vercel (enables secure cookies and the serverless Chromium for PDFs).
NODE_ENV=development

# Skip downloading a full Chrome when installing on Vercel (PDFs use @sparticuz/chromium there).
# PUPPETEER_SKIP_DOWNLOAD=true
