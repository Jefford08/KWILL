<%#
  Step 3 of a password reset / change: choose the new password.
  Locals: layout ('auth'|'app'), action, backHref, backLabel.
%>
<%- include('../partials/header', { title: 'Set a new password' }) %>
<% var inApp = layout === 'app'; %>
<% if (inApp) { %><a href="<%= backHref %>" class="back-link"><%- include('../partials/icon', { name: 'arrowLeft' }) %><%= backLabel %></a><% } %>
<div class="<%= inApp ? 'card content-narrow' : 'auth-card' %>"<%- inApp ? ' style="max-width:480px;margin:0"' : '' %>>
  <div class="auth-icon"><%- include('../partials/icon', { name: 'lock' }) %></div>
  <h1 style="text-align:center;font-size:1.35rem">Set a new password</h1>
  <p class="auth-sub">Code verified. Choose a strong password you haven't used here before.</p>
  <form method="POST" action="<%= action %>" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="password">New password</label>
      <div class="password-field">
        <input type="password" id="password" name="password" autocomplete="new-password" required minlength="8" autofocus>
        <button type="button" class="password-toggle" data-target="password" aria-label="Show password" aria-pressed="false"></button>
      </div>
      <%- include('../partials/password-rules', { target: 'password' }) %>
    </div>
    <div class="field">
      <label for="confirm_password">Confirm new password</label>
      <div class="password-field">
        <input type="password" id="confirm_password" name="confirm_password" autocomplete="new-password" required data-pw-confirm>
        <button type="button" class="password-toggle" data-target="confirm_password" aria-label="Show password" aria-pressed="false"></button>
      </div>
      <p class="field-error" data-pw-confirm-hint hidden>Passwords don't match yet.</p>
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block">Update password</button>
  </form>
  <% if (!inApp) { %><p class="auth-foot"><a href="<%= backHref %>"><%= backLabel %></a></p><% } %>
</div>
<%- include('../partials/footer') %>
