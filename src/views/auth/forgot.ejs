<%- include('../partials/header', { title: 'Forgot password', layout: 'auth' }) %>
<div class="auth-card">
  <div class="auth-icon"><%- include('../partials/icon', { name: 'mail' }) %></div>
  <h1>Forgot your password?</h1>
  <p class="auth-sub">Enter the email address on your account and we'll send you a 6-digit verification code.</p>
  <form method="POST" action="/auth/forgot" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="email">Email address</label>
      <input type="email" id="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" autocomplete="email" maxlength="150" required autofocus>
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block">Send verification code</button>
  </form>
  <p class="auth-foot"><a href="/auth/login">Back to log in</a></p>
</div>
<%- include('../partials/footer') %>
