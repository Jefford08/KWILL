<%- include('../partials/header', { title: 'Log in', layout: 'auth' }) %>
<div class="auth-card">
  <a href="/" class="auth-logo"><img src="/img/kwill-wordmark-logo.svg" alt="Kwill"></a>
  <h1>Welcome back</h1>
  <p class="auth-sub">Log in to your Kwill account.</p>
  <form method="POST" action="/auth/login" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" value="<%= typeof username !== 'undefined' ? username : '' %>" autocomplete="username" autocapitalize="none" spellcheck="false" required <%= typeof username !== 'undefined' && username ? '' : 'autofocus' %> maxlength="20">
    </div>
    <div class="field">
      <label for="password">Password</label>
      <div class="password-field">
        <input type="password" id="password" name="password" autocomplete="current-password" required <%= typeof username !== 'undefined' && username ? 'autofocus' : '' %>>
        <button type="button" class="password-toggle" data-target="password" aria-label="Show password" aria-pressed="false"></button>
      </div>
      <div class="label-row" style="justify-content:flex-end"><a href="/auth/forgot">Forgot password?</a></div>
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block">Log in</button>
  </form>
  <p class="auth-foot">New to Kwill? <a href="/auth/register">Create an account</a></p>
</div>
<p class="auth-legal"><a href="/privacy">Privacy Policy</a></p>
<%- include('../partials/footer') %>
