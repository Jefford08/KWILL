<%- include('../partials/header', { title: 'Eggs' }) %>
<% var isEdit = !!(edit && edit.id); %>
<div class="page-head">
  <div>
    <h1>Egg production</h1>
    <p>Log each day's collection and keep an eye on the damage rate.</p>
  </div>
</div>

<div class="grid-split">
  <section class="card">
    <div class="card-head"><div><h2><%= isEdit ? 'Edit record' : 'New record' %></h2><p>One record per collection day.</p></div></div>
    <form method="POST" action="<%= isEdit ? '/eggs/' + edit.id + '/update' : '/eggs' %>" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="record_date">Date</label>
        <input type="date" id="record_date" name="record_date" value="<%= edit ? edit.record_date : today %>" max="<%= today %>" required>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="eggs_good">Good eggs</label>
          <input type="number" id="eggs_good" name="eggs_good" min="0" inputmode="numeric" value="<%= edit ? edit.eggs_good : '' %>" placeholder="0" required>
        </div>
        <div class="field">
          <label for="eggs_damaged">Damaged eggs</label>
          <input type="number" id="eggs_damaged" name="eggs_damaged" min="0" inputmode="numeric" value="<%= edit ? edit.eggs_damaged : '' %>" placeholder="0" required>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save changes' : 'Save record' %></button>
        <% if (isEdit) { %><a class="btn btn-ghost" href="/eggs">Cancel</a><% } %>
      </div>
    </form>
  </section>

  <section class="card">
    <div class="card-head">
      <div><h2>Production trend</h2><p>Total eggs collected per period.</p></div>
      <%- include('../partials/chart-controls') %>
    </div>
    <div class="chart-box chart-box-sm"><canvas id="trend-chart" data-metric="eggs"></canvas></div>
  </section>
</div>

<section class="card card-flush">
  <div class="card-head"><div><h2>Records</h2><p><%= number(page.total) %> <%= page.total === 1 ? 'record' : 'records' %><%= page.filtered ? ' in this range' : '' %></p></div>
    <%- include('../partials/table-filter') %>
  </div>
  <% if (records.length === 0) { %>
    <div class="empty">
      <%- include('../partials/icon', { name: 'inbox' }) %>
      <strong><%= page.filtered ? 'Nothing recorded in this date range' : 'No egg records yet' %></strong>
      <p><%= page.filtered ? 'Try a different range, or clear the filter.' : 'Your daily collections will appear here once you add them.' %></p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Date</th><th class="num">Good</th><th class="num">Damaged</th><th class="num">Total</th><th class="num">Damage rate</th><th><span class="sr-only">Actions</span></th></tr></thead>
        <tbody>
        <% records.forEach(function (r) { %>
          <tr data-row-id="<%= r.id %>"<%- isEdit && String(edit.id) === String(r.id) ? ' class="is-editing"' : '' %>>
            <td class="nowrap"><%= formatDate(r.record_date) %></td>
            <td class="num"><%= number(r.eggs_good) %></td>
            <td class="num"><%= number(r.eggs_damaged) %></td>
            <td class="num"><strong><%= number(r.total) %></strong></td>
            <td class="num"><span class="badge <%= r.damageRate >= 10 ? 'badge-red' : r.damageRate >= 5 ? 'badge-amber' : 'badge-green' %>"><%= r.damageRate %>%</span></td>
            <td class="actions">
              <div class="row-actions">
                <a class="btn btn-ghost" href="/eggs/<%= r.id %>/edit">Edit</a>
                <form method="POST" action="/eggs/<%= r.id %>/delete" class="inline-form" data-confirm-title="Delete this egg record?" data-confirm="It will be removed from your history and totals. This cannot be undone.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-ghost danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pager') %>
  <% } %>
</section>

<%- include('../partials/chart-scripts') %>
<%- include('../partials/footer') %>
