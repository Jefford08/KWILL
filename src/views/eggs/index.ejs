<%- include('../partials/header', { title: 'Egg Production' }) %>
<h1>Egg Production</h1>

<% if (typeof error !== 'undefined' && error) { %>
  <p class="alert alert-error"><%= error %></p>
<% } %>

<form method="POST" action="<%= (edit && edit.id) ? '/eggs/' + edit.id + '/update' : '/eggs' %>" class="form-large">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label for="record_date">Date</label>
  <input type="date" id="record_date" name="record_date" value="<%= edit ? edit.record_date : today %>" required>

  <label for="eggs_good">Good Eggs</label>
  <input type="number" id="eggs_good" name="eggs_good" min="0" value="<%= edit ? edit.eggs_good : 0 %>" required>

  <label for="eggs_damaged">Damaged Eggs</label>
  <input type="number" id="eggs_damaged" name="eggs_damaged" min="0" value="<%= edit ? edit.eggs_damaged : 0 %>" required>

  <button type="submit" class="btn btn-primary btn-large"><%= (edit && edit.id) ? 'Update Record' : 'Add Egg Record' %></button>
  <% if (edit && edit.id) { %><a class="btn btn-secondary" href="/eggs">Cancel</a><% } %>
</form>

<h2>Trend</h2>
<%- include('../partials/chart-controls') %>
<canvas id="trend-chart" data-metric="eggs" height="100"></canvas>

<h2>Previous Records</h2>
<table class="data-table">
  <thead><tr><th>Date</th><th>Good</th><th>Damaged</th><th>Total</th><th>Damage Rate</th><th>Actions</th></tr></thead>
  <tbody>
  <% records.forEach(function(r) { %>
    <tr>
      <td><%= r.record_date %></td>
      <td><%= r.eggs_good %></td>
      <td><%= r.eggs_damaged %></td>
      <td><%= r.total %></td>
      <td><%= r.damageRate %>%</td>
      <td>
        <a class="btn btn-small" href="/eggs/<%= r.id %>/edit">Edit</a>
        <form method="POST" action="/eggs/<%= r.id %>/delete" class="inline-form" onsubmit="return confirm('Delete this record?');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-small btn-danger">Delete</button>
        </form>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="/js/charts.js"></script>
<%- include('../partials/footer') %>
