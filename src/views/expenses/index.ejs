<%- include('../partials/header', { title: 'Expenses' }) %>
<% var isEdit = !!(edit && edit.id); %>
<div class="page-head">
  <div>
    <h1>Expenses</h1>
    <p>Medicine, labor, utilities and anything else the farm spends on.</p>
  </div>
</div>

<div class="grid-split">
  <section class="card">
    <div class="card-head"><div><h2><%= isEdit ? 'Edit expense' : 'New expense' %></h2><p>Anything the farm pays for.</p></div></div>
    <form method="POST" action="<%= isEdit ? '/expenses/' + edit.id + '/update' : '/expenses' %>" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-row">
        <div class="field">
          <label for="expense_date">Date</label>
          <input type="date" id="expense_date" name="expense_date" value="<%= edit ? edit.expense_date : today %>" max="<%= today %>" required>
        </div>
        <div class="field">
          <label for="amount">Amount</label>
          <div class="input-prefix"><span>₱</span><input type="number" step="0.01" min="0" inputmode="decimal" id="amount" name="amount" value="<%= edit ? edit.amount : '' %>" placeholder="0.00" required></div>
        </div>
      </div>
      <div class="field">
        <label for="category">Category</label>
        <input type="text" id="category" name="category" list="expense-categories" maxlength="100" value="<%= edit ? edit.category : '' %>" placeholder="e.g. Medicine" required>
        <datalist id="expense-categories">
          <option value="Medicine"><option value="Labor"><option value="Utilities"><option value="Equipment"><option value="Transport"><option value="Repairs">
        </datalist>
      </div>
      <div class="field">
        <label for="description">Description <span class="optional">(optional)</span></label>
        <input type="text" id="description" name="description" maxlength="255" value="<%= edit && edit.description ? edit.description : '' %>" placeholder="What was it for?">
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save changes' : 'Save expense' %></button>
        <% if (isEdit) { %><a class="btn btn-ghost" href="/expenses">Cancel</a><% } %>
      </div>
    </form>
  </section>

  <section class="card">
    <div class="card-head">
      <div><h2>Spending trend</h2><p>Expenses per period.</p></div>
      <%- include('../partials/chart-controls') %>
    </div>
    <div class="chart-box chart-box-sm"><canvas id="trend-chart" data-metric="expenses"></canvas></div>
  </section>
</div>

<section class="card card-flush">
  <div class="card-head"><div><h2>History</h2><p><%= number(page.total) %> <%= page.total === 1 ? 'expense' : 'expenses' %><%= page.filtered ? ' in this range' : '' %></p></div>
    <%- include('../partials/table-filter') %>
  </div>
  <% if (records.length === 0) { %>
    <div class="empty">
      <%- include('../partials/icon', { name: 'inbox' }) %>
      <strong><%= page.filtered ? 'Nothing recorded in this date range' : 'No expenses yet' %></strong>
      <p><%= page.filtered ? 'Try a different range, or clear the filter.' : 'Expenses you record will appear here.' %></p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Date</th><th>Category</th><th>Description</th><th class="num">Amount</th><th><span class="sr-only">Actions</span></th></tr></thead>
        <tbody>
        <% records.forEach(function (r) { %>
          <tr data-row-id="<%= r.id %>"<%- isEdit && String(edit.id) === String(r.id) ? ' class="is-editing"' : '' %>>
            <td class="nowrap"><%= formatDate(r.expense_date) %></td>
            <td><span class="badge"><%= r.category %></span></td>
            <td class="muted"><%= r.description || '—' %></td>
            <td class="num"><strong><%= money(r.amount) %></strong></td>
            <td class="actions">
              <div class="row-actions">
                <a class="btn btn-ghost" href="/expenses/<%= r.id %>/edit">Edit</a>
                <form method="POST" action="/expenses/<%= r.id %>/delete" class="inline-form" data-confirm-title="Delete this expense?" data-confirm="It will be removed from your history and totals. This cannot be undone.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-ghost danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pager') %>
  <% } %>
</section>

<%- include('../partials/chart-scripts') %>
<%- include('../partials/footer') %>
