<%- include('../partials/header', { title: 'Feed' }) %>
<div class="page-head">
  <div>
    <h1>Feed</h1>
    <p>Record what you buy and what your quails eat.</p>
  </div>
</div>

<div class="grid-2">
  <section class="card">
    <div class="card-head"><div><h2>Purchase</h2><p>Feed bought and what it cost.</p></div></div>
    <form method="POST" action="/feed/purchase" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="purchase_date">Date</label>
        <input type="date" id="purchase_date" name="purchase_date" value="<%= today %>" max="<%= today %>" required>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="quantity_kg_p">Quantity (kg)</label>
          <input type="number" step="0.01" min="0" inputmode="decimal" id="quantity_kg_p" name="quantity_kg" placeholder="0.00" required>
        </div>
        <div class="field">
          <label for="cost">Cost</label>
          <div class="input-prefix"><span>₱</span><input type="number" step="0.01" min="0" inputmode="decimal" id="cost" name="cost" placeholder="0.00" required></div>
        </div>
      </div>
      <div class="form-actions"><button type="submit" class="btn btn-primary">Save purchase</button></div>
    </form>
  </section>

  <section class="card">
    <div class="card-head"><div><h2>Consumption</h2><p>Feed used by your quails.</p></div></div>
    <form method="POST" action="/feed/consumption" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="consumption_date">Date</label>
        <input type="date" id="consumption_date" name="consumption_date" value="<%= today %>" max="<%= today %>" required>
      </div>
      <div class="field">
        <label for="quantity_kg_c">Quantity used (kg)</label>
        <input type="number" step="0.01" min="0" inputmode="decimal" id="quantity_kg_c" name="quantity_kg" placeholder="0.00" required>
      </div>
      <div class="form-actions"><button type="submit" class="btn btn-primary">Save consumption</button></div>
    </form>
  </section>
</div>

<section class="card">
  <div class="card-head">
    <div><h2>Consumption trend</h2><p>Kilograms used per period.</p></div>
    <%- include('../partials/chart-controls') %>
  </div>
  <div class="chart-box chart-box-sm"><canvas id="trend-chart" data-metric="feed"></canvas></div>
</section>

<section class="card card-flush">
  <div class="card-head"><div><h2>History</h2><p><%= number(page.total) %> <%= page.total === 1 ? 'entry' : 'entries' %><%= page.filtered ? ' in this range' : '' %></p></div>
    <%- include('../partials/table-filter') %>
  </div>
  <% if (history.length === 0) { %>
    <div class="empty">
      <%- include('../partials/icon', { name: 'inbox' }) %>
      <strong><%= page.filtered ? 'Nothing recorded in this date range' : 'No feed entries yet' %></strong>
      <p><%= page.filtered ? 'Try a different range, or clear the filter.' : 'Purchases and consumption you record will show up here.' %></p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Date</th><th>Type</th><th class="num">Quantity</th><th class="num">Cost</th><th><span class="sr-only">Actions</span></th></tr></thead>
        <tbody>
        <% history.forEach(function (r) { %>
          <tr data-row-id="<%= r.kind %>-<%= r.id %>">
            <td class="nowrap"><%= formatDate(r.date) %></td>
            <td><span class="badge <%= r.kind === 'purchase' ? 'badge-blue' : 'badge-amber' %>"><%= r.kind === 'purchase' ? 'Purchase' : 'Consumption' %></span></td>
            <td class="num"><%= number(r.quantity_kg) %> kg</td>
            <td class="num"><%= r.kind === 'purchase' ? money(r.cost) : '—' %></td>
            <td class="actions">
              <div class="row-actions">
                <form method="POST" action="/feed/<%= r.kind %>/<%= r.id %>/delete" class="inline-form" data-confirm-title="Delete this feed entry?" data-confirm="It will be removed from your history and totals. This cannot be undone.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-ghost danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pager') %>
  <% } %>
</section>

<%- include('../partials/chart-scripts') %>
<%- include('../partials/footer') %>
