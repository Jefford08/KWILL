<%- include('partials/header', { title: 'Welcome', hideNav: true, bodyClass: 'landing-page' }) %>
<div class="landing">
  <div class="landing-hero">
    <div class="landing-brand"><img src="/img/kwill-wordmark-logo.svg" alt="Kwill" class="brand-wordmark"></div>
    <h1>Run your quail farm from one screen.</h1>
    <p class="landing-sub">
      Eggs, mortality, feed, sales and expenses, logged in seconds and tracked over time.
      See where the farm stands today, and export a report when you need one.
    </p>
    <div class="landing-stats">
      <span class="landing-stat">Egg production</span>
      <span class="landing-stat">Mortality trends</span>
