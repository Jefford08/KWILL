<%- include('../partials/header', { title: 'Mortality Tracking' }) %>
<h1>Mortality Tracking</h1>

<% if (typeof error !== 'undefined' && error) { %>
  <p class="alert alert-error"><%= error %></p>
<% } %>

<form method="POST" action="<%= (edit && edit.id) ? '/mortality/' + edit.id + '/update' : '/mortality' %>" class="form-large">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label for="entry_date">Date</label>
  <input type="date" id="entry_date" name="entry_date" value="<%= edit ? edit.entry_date : today %>" required>

  <label for="quantity">Number of Dead Quails</label>
  <input type="number" id="quantity" name="quantity" min="1" value="<%= edit ? edit.quantity : 1 %>" required>

  <label for="note">Note (optional)</label>
  <input type="text" id="note" name="note" value="<%= edit && edit.note ? edit.note : '' %>">

  <button type="submit" class="btn btn-primary btn-large"><%= (edit && edit.id) ? 'Update Entry' : 'Record Mortality' %></button>
  <% if (edit && edit.id) { %><a class="btn btn-secondary" href="/mortality">Cancel</a><% } %>
</form>

<h2>Trend</h2>
<%- include('../partials/chart-controls') %>
<canvas id="trend-chart" data-metric="mortality" height="100"></canvas>

<h2>History</h2>
<table class="data-table">
  <thead><tr><th>Date</th><th>Dead</th><th>Population Before</th><th>Mortality Rate</th><th>Note</th><th>Actions</th></tr></thead>
  <tbody>
  <% records.forEach(function(r) { %>
    <tr>
      <td><%= r.entry_date %></td>
      <td><%= r.quantity %></td>
      <td><%= r.population_before %></td>
      <td><%= r.mortalityRate %>%</td>
      <td><%= r.note || '-' %></td>
      <td>
        <a class="btn btn-small" href="/mortality/<%= r.id %>/edit">Edit</a>
        <form method="POST" action="/mortality/<%= r.id %>/delete" class="inline-form" onsubmit="return confirm('Delete this entry?');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-small btn-danger">Delete</button>
        </form>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="/js/charts.js"></script>
<%- include('../partials/footer') %>
