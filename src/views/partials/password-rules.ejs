<%
  var rules = passwordRules;
%>
<div class="pw-meter" data-pw-meter="<%= target %>" aria-live="polite">
  <div class="pw-meter-top">
    <div class="pw-bar" aria-hidden="true"><span></span><span></span><span></span></div>
    <span class="pw-label" data-pw-label>Weak</span>
  </div>
  <ul class="pw-rules">
    <% rules.forEach(function (r) { %>
      <li data-rule="<%= r.key %>"><%- include('icon', { name: 'check' }) %><%= r.label %></li>
    <% }); %>
  </ul>
</div>
