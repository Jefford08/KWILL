<%- include('../partials/header', { title: moduleLabel + ' report' }) %>
<%
  var ISO = /^\d{4}-\d{2}-\d{2}$/;
  function cell(v) { return ISO.test(String(v)) ? formatDate(v) : v; }
  function isNumeric(v) { return /^[-−]?₱?[\d,.]+%?$/.test(String(v).trim()); }
%>
<a href="/reports" class="back-link no-print"><%- include('../partials/icon', { name: 'arrowLeft' }) %>All reports</a>
<div class="page-head">
  <div>
    <h1><%= moduleLabel %> report</h1>
    <p><span class="report-period"><%= formatDate(from) %> – <%= formatDate(to) %></span></p>
  </div>
  <div class="page-actions no-print">
    <a class="btn btn-primary" data-no-loading href="/reports/pdf?module=<%= module %>&from=<%= from %>&to=<%= to %>&granularity=<%= granularity %>">
      <%- include('../partials/icon', { name: 'download' }) %>Export PDF
    </a>
  </div>
</div>

<section class="stats" aria-label="Summary">
  <% summary.forEach(function (s) { %>
    <div class="stat">
      <span class="stat-label"><%= s.label %></span>
      <span class="stat-value"><%= s.value %></span>
    </div>
  <% }); %>
</section>

<section class="card">
  <div class="card-head"><div><h2>Trend</h2></div></div>
  <div class="chart-box"><canvas id="trend-chart" data-metric="<%= chartMetric %>" data-from="<%= from %>" data-to="<%= to %>" data-granularity="<%= granularity %>"></canvas></div>
</section>

<section class="card card-flush">
  <div class="card-head"><div><h2>Records</h2><p><%= rows.length %> row<%= rows.length === 1 ? '' : 's' %></p></div></div>
  <% if (rows.length === 0) { %>
    <div class="empty">
      <%- include('../partials/icon', { name: 'inbox' }) %>
      <strong>Nothing recorded in this period</strong>
      <p>Try a wider date range.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><% columns.forEach(function (c, i) { %><th<%- i > 0 && isNumeric(rows[0][i]) ? ' class="num"' : '' %>><%= c %></th><% }); %></tr></thead>
        <tbody>
          <% rows.forEach(function (row) { %>
            <tr><% row.forEach(function (v, i) { %><td<%- i > 0 && isNumeric(v) ? ' class="num"' : (i === 0 ? ' class="nowrap"' : '') %>><%= cell(v) %></td><% }); %></tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/chart-scripts') %>
<%- include('../partials/footer') %>
