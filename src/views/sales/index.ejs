<%- include('../partials/header', { title: 'Sales' }) %>
<% var isEdit = !!(edit && edit.id); var item = (edit && edit.item_type) || 'egg'; %>
<div class="page-head">
  <div>
    <h1>Sales</h1>
    <p>Record eggs and quails sold. Totals feed straight into your profit.</p>
  </div>
</div>

<div class="grid-split">
  <section class="card">
    <div class="card-head"><div><h2><%= isEdit ? 'Edit sale' : 'New sale' %></h2><p>Quantity × unit price is calculated for you.</p></div></div>
    <form method="POST" action="<%= isEdit ? '/sales/' + edit.id + '/update' : '/sales' %>" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <span class="label" id="item-label">Item sold</span>
        <div class="segmented" role="radiogroup" aria-labelledby="item-label">
          <input type="radio" id="item-egg" name="item_type" value="egg" <%= item === 'egg' ? 'checked' : '' %>><label for="item-egg">Eggs</label>
          <input type="radio" id="item-quail" name="item_type" value="quail" <%= item === 'quail' ? 'checked' : '' %>><label for="item-quail">Quails</label>
        </div>
      </div>
      <div class="field">
        <label for="sale_date">Date</label>
        <input type="date" id="sale_date" name="sale_date" value="<%= edit ? edit.sale_date : today %>" max="<%= today %>" required>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="quantity">Quantity</label>
          <input type="number" min="1" inputmode="numeric" id="quantity" name="quantity" value="<%= edit ? edit.quantity : '' %>" placeholder="0" required>
        </div>
        <div class="field">
          <label for="unit_price">Unit price</label>
          <div class="input-prefix"><span>₱</span><input type="number" step="0.01" min="0" inputmode="decimal" id="unit_price" name="unit_price" value="<%= edit ? edit.unit_price : '' %>" placeholder="0.00" required></div>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save changes' : 'Save sale' %></button>
        <% if (isEdit) { %><a class="btn btn-ghost" href="/sales">Cancel</a><% } %>
      </div>
    </form>
  </section>

  <section class="card">
    <div class="card-head">
      <div><h2>Sales trend</h2><p>Revenue per period.</p></div>
      <%- include('../partials/chart-controls') %>
    </div>
    <div class="chart-box chart-box-sm"><canvas id="trend-chart" data-metric="sales"></canvas></div>
  </section>
</div>

<section class="card card-flush">
  <div class="card-head"><div><h2>History</h2><p><%= number(page.total) %> <%= page.total === 1 ? 'sale' : 'sales' %><%= page.filtered ? ' in this range' : '' %></p></div>
    <%- include('../partials/table-filter') %>
  </div>
  <% if (records.length === 0) { %>
    <div class="empty">
      <%- include('../partials/icon', { name: 'inbox' }) %>
      <strong><%= page.filtered ? 'Nothing recorded in this date range' : 'No sales yet' %></strong>
      <p><%= page.filtered ? 'Try a different range, or clear the filter.' : 'Sales you record will appear here.' %></p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Date</th><th>Item</th><th class="num">Qty</th><th class="num">Unit price</th><th class="num">Total</th><th><span class="sr-only">Actions</span></th></tr></thead>
        <tbody>
        <% records.forEach(function (r) { %>
          <tr data-row-id="<%= r.id %>"<%- isEdit && String(edit.id) === String(r.id) ? ' class="is-editing"' : '' %>>
            <td class="nowrap"><%= formatDate(r.sale_date) %></td>
            <td><span class="badge <%= r.item_type === 'egg' ? 'badge-amber' : 'badge-green' %>"><%= r.item_type === 'egg' ? 'Eggs' : 'Quails' %></span></td>
            <td class="num"><%= number(r.quantity) %></td>
            <td class="num"><%= money(r.unit_price) %></td>
            <td class="num"><strong><%= money(r.total) %></strong></td>
            <td class="actions">
              <div class="row-actions">
                <a class="btn btn-ghost" href="/sales/<%= r.id %>/edit">Edit</a>
                <form method="POST" action="/sales/<%= r.id %>/delete" class="inline-form" data-confirm-title="Delete this sale?" data-confirm="It will be removed from your history and totals. This cannot be undone.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-ghost danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pager') %>
  <% } %>
</section>

<%- include('../partials/chart-scripts') %>
<%- include('../partials/footer') %>
